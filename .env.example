# ---- Frontend (bundled into the web build AND the Android APK — public values only!) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Full URL of the Vercel deployment. Leave empty for the web build (uses same origin);
# REQUIRED for the Android build, e.g. https://motor-cycle-system.vercel.app
VITE_API_BASE_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# ---- Server only (set in Vercel → Project → Settings → Environment Variables) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
RESEND_API_KEY=
CRON_SECRET=
# Comma-separated extra origins allowed to call /api (Vercel domains are added automatically)
ALLOWED_ORIGINS=
